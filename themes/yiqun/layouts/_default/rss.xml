{{- $posts := where site.RegularPages "Section" "posts" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.BaseURL }}</link>
    <description>{{ site.Params.description }}</description>
    <language>zh-CN</language>
    {{- with index $posts.ByDate.Reverse 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{ printf "<atom:link href=%q rel=\"self\" type=\"application/rss+xml\" />" (.Permalink | printf "%sindex.xml") | safeHTML }}
    {{- range first 20 $posts.ByDate.Reverse }}
    <item>
      <title>{{ with partial "series-page.html" . }}{{ .Title }} No.{{ $.Params.issue }}｜{{ end }}{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Params.summary | default (.Plain | truncate 120) }}</description>
      <content:encoded>{{ .Content | html }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
